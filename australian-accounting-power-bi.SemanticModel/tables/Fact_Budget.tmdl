table Fact_Budget
	lineageTag: a1b2c3d4-bud-0007-8899-aabbccddeeff

	measure 'Budget Amount' = SUM(Fact_Budget[BudgetAmount])
		formatString: $#,##0.00;($#,##0.00);$0.00
		lineageTag: bud-meas-0001
		description: "Total budgeted amount for the selected period."

	measure 'Budget Revenue' =
			CALCULATE(
				SUM(Fact_Budget[BudgetAmount]),
				Dim_Account[Class] = "Revenue"
			)
		formatString: $#,##0.00;($#,##0.00);$0.00
		lineageTag: bud-meas-0002
		description: "Total budgeted revenue."

	measure 'Budget Expenses' =
			CALCULATE(
				SUM(Fact_Budget[BudgetAmount]),
				Dim_Account[Class] = "Expense"
			)
		formatString: $#,##0.00;($#,##0.00);$0.00
		lineageTag: bud-meas-0003
		description: "Total budgeted expenses."

	measure 'Budget Variance $' = [Revenue] - [Budget Revenue]
		formatString: $#,##0.00;($#,##0.00);$0.00
		lineageTag: bud-meas-0004
		description: "Variance between actual revenue and budgeted revenue."

	measure 'Budget Variance %' = DIVIDE([Budget Variance $], [Budget Revenue], 0)
		formatString: 0.0%
		lineageTag: bud-meas-0005
		description: "Percentage variance against revenue budget."

	column PeriodDate
		dataType: dateTime
		formatString: yyyy-mm-dd
		lineageTag: bud-col-0001
		summarizeBy: none
		sourceColumn: PeriodDate

	column EntityID
		dataType: string
		lineageTag: bud-col-0002
		summarizeBy: none
		sourceColumn: EntityID

	column AccountCode
		dataType: string
		lineageTag: bud-col-0003
		summarizeBy: none
		sourceColumn: AccountCode

	column BudgetAmount
		dataType: double
		formatString: $#,##0.00
		lineageTag: bud-col-0004
		summarizeBy: sum
		sourceColumn: BudgetAmount

	partition Fact_Budget = m
		mode: import
		source =
			let
				Source = Fact_Budget
			in
				Source
