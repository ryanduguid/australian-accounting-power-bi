	column IsIntercompany
		dataType: boolean
		formatString: """TRUE"";""TRUE"";""FALSE"""
		lineageTag: gl-col-0011
		summarizeBy: none
		sourceColumn: IsIntercompany

	partition Fact_GeneralLedger = m
		mode: import
		source =
			let
				Source = Fact_GeneralLedger
			in
				Source
